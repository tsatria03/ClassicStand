void readdata()
{
    sd.load();
    if (sd.d.exists("me.x"))
{
me.x = sd.read_float("me.x");
}
    if (sd.d.exists("me.y"))
{
me.y = sd.read_float("me.y");
}
    if (sd.d.exists("cash"))
{
cash = sd.read_double("cash");
}
    if (sd.d.exists("fullcups"))
{
fullcups = sd.read_double("fullcups");
}
    if (sd.d.exists("soldcups"))
{
soldcups = sd.read_double("soldcups");
}
    if (sd.d.exists("level"))
{
level = sd.read_double("level");
}
    if (sd.d.exists("maxlevel"))
{
maxlevel = sd.read_double("maxlevel");
}
    if (sd.d.exists("pitcherstat"))
{
pitcherstat = sd.read_double("pitcherstat");
}
    if (sd.d.exists("cups"))
{
cups = sd.read_double("cups");
}
    if (sd.d.exists("ices"))
{
ices = sd.read_double("ices");
}
    if (sd.d.exists("lemons"))
{
lemons = sd.read_double("lemons");
}
    if (sd.d.exists("salts"))
{
salts = sd.read_double("salts");
}
    if (sd.d.exists("sugars"))
{
sugars = sd.read_double("sugars");
}
    if (sd.d.exists("waters"))
{
waters = sd.read_double("waters");
}
    if (sd.d.exists("cupcost"))
{
cupcost = sd.read_double("cupcost");
}
    if (sd.d.exists("icecost"))
{
icecost = sd.read_double("icecost");
}
    if (sd.d.exists("lemoncost"))
{
lemoncost = sd.read_double("lemoncost");
}
    if (sd.d.exists("saltcost"))
{
saltcost = sd.read_double("saltcost");
}
    if (sd.d.exists("sugarcost"))
{
sugarcost = sd.read_double("sugarcost");
}
    if (sd.d.exists("watercost"))
{
watercost = sd.read_double("watercost");
}
    if (sd.d.exists("clocktime"))
{
clocktime = sd.read_int("clocktime");
}
    if (sd.d.exists("current_day_index"))
{
current_day_index = sd.read_int("current_day_index");
}
    if (sd.d.exists("current_month_index"))
{
current_month_index = sd.read_int("current_month_index");
}
    if (sd.d.exists("daynumber"))
{
daynumber = sd.read_int("daynumber");
}
    if (sd.d.exists("pitcher"))
{
pitcher = sd.read_int("pitcher");
}
    if (sd.d.exists("temperature"))
{
temperature = sd.read_int("temperature");
}
if (sd.d.exists("dayname"))
{
dayname = sd.read_string("dayname");
}
if (sd.d.exists("monthname"))
{
monthname = sd.read_string("monthname");
}
if (sd.d.exists("reputation"))
{
reputation = sd.read_double("reputation");
}
if (sd.d.exists("peak_reputation"))
{
peak_reputation = sd.read_double("peak_reputation");
}
if (sd.d.exists("last_lemons_per_cup"))
last_lemons_per_cup = sd.read_double("last_lemons_per_cup");
if (sd.d.exists("last_sugars_per_cup"))
last_sugars_per_cup = sd.read_double("last_sugars_per_cup");
if (sd.d.exists("last_waters_per_cup"))
last_waters_per_cup = sd.read_double("last_waters_per_cup");
if (sd.d.exists("last_ices_per_cup"))
last_ices_per_cup = sd.read_double("last_ices_per_cup");
if (sd.d.exists("last_salts_per_cup"))
last_salts_per_cup = sd.read_double("last_salts_per_cup");
if (sd.d.exists("poster_basic"))
poster_basic = sd.read_int("poster_basic");
if (sd.d.exists("poster_colorful"))
poster_colorful = sd.read_int("poster_colorful");
if (sd.d.exists("poster_premium"))
poster_premium = sd.read_int("poster_premium");
if (sd.d.exists("placed_posters"))
placed_posters = sd.read_int("placed_posters");
if (sd.d.exists("floor_spilled"))
floor_spilled = sd.read_bool("floor_spilled");
if (sd.d.exists("poster_tiles"))
{
poster_tiles.resize(0);
string pts = sd.read_string("poster_tiles");
if(pts != "")
{
string[] pparts = string_split(pts, ";", true);
for(uint i=0; i<pparts.length(); i++)
if(pparts[i] != "") poster_tiles.insert_last(pparts[i]);
}
}
if (sd.d.exists("cup_lemons"))
{
cup_lemons.resize(0);
cup_sugars.resize(0);
cup_waters.resize(0);
cup_ices.resize(0);
cup_salts.resize(0);
string csl = sd.read_string("cup_lemons");
if(csl != "")
{
string[] arr_lem = string_split(csl, ",", true);
string[] arr_sug = string_split(sd.read_string("cup_sugars"), ",", true);
string[] arr_wat = string_split(sd.read_string("cup_waters"), ",", true);
string[] arr_ice = string_split(sd.read_string("cup_ices"), ",", true);
string[] arr_sal = string_split(sd.read_string("cup_salts"), ",", true);
for(uint i=0; i<arr_lem.length(); i++)
{
cup_lemons.insert_last(string_to_number(arr_lem[i]));
cup_sugars.insert_last(string_to_number(arr_sug[i]));
cup_waters.insert_last(string_to_number(arr_wat[i]));
cup_ices.insert_last(string_to_number(arr_ice[i]));
cup_salts.insert_last(string_to_number(arr_sal[i]));
}
}
}
int cur_napkin = item_exists("napkin");
if(cur_napkin > 0) give("napkin", -cur_napkin);
int cur_used = item_exists("used_napkin");
if(cur_used > 0) give("used_napkin", -cur_used);
if (sd.d.exists("napkin"))
{
int n = sd.read_int("napkin");
if(n > 0) give("napkin", n);
}
if (sd.d.exists("used_napkin"))
{
int un = sd.read_int("used_napkin");
if(un > 0) give("used_napkin", un);
}
}
void writedata()
{
sd.add("me.x", me.x);
sd.add("me.y", me.y);
    sd.add("cash", cash);
    sd.add("fullcups", fullcups);
sd.add("soldcups", soldcups);
    sd.add("level", level);
    sd.add("maxlevel", maxlevel);
    sd.add("pitcherstat", pitcherstat);
    sd.add("cups", cups);
    sd.add("ices", ices);
    sd.add("lemons", lemons);
    sd.add("salts", salts);
    sd.add("sugars", sugars);
    sd.add("waters", waters);
    sd.add("cupcost", cupcost);
    sd.add("icecost", icecost);
    sd.add("lemoncost", lemoncost);
    sd.add("saltcost", saltcost);
    sd.add("sugarcost", sugarcost);
    sd.add("watercost", watercost);
    sd.add("clocktime", clocktime);
sd.add("current_day_index", current_day_index);
sd.add("current_month_index", current_month_index);
    sd.add("daynumber", daynumber);
    sd.add("pitcher", pitcher);
    sd.add("temperature", temperature);
sd.add("dayname", dayname);
sd.add("monthname", monthname);
sd.add("reputation", reputation);
sd.add("peak_reputation", peak_reputation);
sd.add("last_lemons_per_cup", last_lemons_per_cup);
sd.add("last_sugars_per_cup", last_sugars_per_cup);
sd.add("last_waters_per_cup", last_waters_per_cup);
sd.add("last_ices_per_cup", last_ices_per_cup);
sd.add("last_salts_per_cup", last_salts_per_cup);
sd.add("poster_basic", poster_basic);
sd.add("poster_colorful", poster_colorful);
sd.add("poster_premium", poster_premium);
sd.add("placed_posters", placed_posters);
string poster_tiles_str = "";
for(uint i=0; i<poster_tiles.length(); i++)
{
if(i > 0) poster_tiles_str += ";";
poster_tiles_str += poster_tiles[i];
}
sd.add("poster_tiles", poster_tiles_str);
string cl="", cs="", cw="", ci="", csa="";
for(uint i=0; i<cup_lemons.length(); i++)
{
if(i > 0) { cl+=","; cs+=","; cw+=","; ci+=","; csa+=","; }
cl += "" + cup_lemons[i];
cs += "" + cup_sugars[i];
cw += "" + cup_waters[i];
ci += "" + cup_ices[i];
csa += "" + cup_salts[i];
}
sd.add("cup_lemons", cl);
sd.add("cup_sugars", cs);
sd.add("cup_waters", cw);
sd.add("cup_ices", ci);
sd.add("cup_salts", csa);
int napkin_ct = item_exists("napkin");
if(napkin_ct < 0) napkin_ct = 0;
int used_napkin_ct = item_exists("used_napkin");
if(used_napkin_ct < 0) used_napkin_ct = 0;
sd.add("napkin", napkin_ct);
sd.add("used_napkin", used_napkin_ct);
sd.add("floor_spilled", floor_spilled);
    sd.save();
}
void readpreffs()
{
    st.load();
    if (st.d.exists("menumusvolume"))
{
menumusvolume = st.read_int("menumusvolume");
}
    if (st.d.exists("sourcevolume"))
{
sourcevolume = st.read_int("sourcevolume");
}
    if (st.d.exists("busprofed"))
{
busprofed = st.read_bool("busprofed");
}
    if (st.d.exists("business_name"))
{
business_name = st.read_string("business_name");
}
}
void writepreffs()
{
    st.add("menumusvolume", menumusvolume);
st.add("sourcevolume", sourcevolume);
st.add("busprofed", busprofed);
st.add("business_name",business_name);
    st.save();
}
